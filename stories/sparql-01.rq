PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX cto:    <https://nfdi4culture.de/ontology#>
PREFIX n4c:    <https://nfdi4culture.de/id/>

SELECT
  ?creatorGND
  ?artistName
  (?countE6077 + ?countBildindex AS ?countTotal)
  ?countE6077
  ?countBildindex
WHERE {
  # E6077 counts
  {
    SELECT ?creatorGND (COUNT(DISTINCT ?art) AS ?countE6077)
    WHERE {
      ?art cto:elementOf n4c:E6077 ;
           a/rdfs:subClassOf* schema:VisualArtwork ;
           (schema:creator|schema:artist) ?creatorGND .
    }
    GROUP BY ?creatorGND
  }

  # Bildindex counts (left join so artists with 0 still show up)
  OPTIONAL {
    SELECT ?creatorGND (COUNT(DISTINCT ?bild) AS ?_countBildindex)
    WHERE {
      ?bild ?p ?creatorGND .
      FILTER regex(str(?bildindexEntity), "https?://(www\\.)?bildindex\\.de/")
    }
    GROUP BY ?creatorGND
  }

  # normalize OPTIONAL -> 0
  BIND(COALESCE(?_countBildindex, 0) AS ?countBildindex)

  # Label (sample to avoid duplicates)
  OPTIONAL {
    SELECT ?creatorGND (SAMPLE(?lbl) AS ?artistName)
    WHERE { ?creatorGND rdfs:label ?lbl }
    GROUP BY ?creatorGND
  }
}
ORDER BY DESC(?countTotal)